# Server
PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (PostgreSQL on Neon)
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/cardesk?sslmode=require

# Gemini AI (@google/genai)
GEMINI_API_KEY=your_gemini_api_key_here
ANALYSIS_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite
CHECK_MODEL=gemini-3.8-flash
CHECK_THINKING_LEVEL=low
CHECK_MODEL_FALLBACK=gemini-3.5-flash-lite
GEMINI_MAX_CONCURRENT=3
ANALYSIS_TIMEOUT_MS=30000
CHECK_TIMEOUT_MS=45000
CHAT_INTENT_TIMEOUT_MS=15000
ANALYSIS_IMAGE_MAX_EDGE=1024
CHECK_IMAGE_MAX_EDGE=768

# Image Editing (kie | qwen_http | magichour | mock)
EDIT_PROVIDER=mock
EDIT_FALLBACK_PROVIDER=qwen_http
KIE_API_KEY=your_kie_api_key_here
KIE_API_KEY_2=your_second_kie_api_key_here
KIE_MODEL_NAME=google/nano-banana-edit
EDIT_API_URL=https://api.example.com/v1/images/edits
EDIT_API_KEY=your_edit_api_key_here
EDIT_MODEL_NAME=qwen-image-edit
EDIT_RESOLUTION=640px
EDIT_PROMPT_MODE=ai
EDIT_TIMEOUT_MS=45000

# Trigger.dev
TRIGGER_SECRET_KEY=tr_dev_your_secret_key_here
TRIGGER_PROJECT_REF=proj_dmnjwndevjpjdjnhtnmc
TRIGGER_IMAGE_CONCURRENCY=3

# Pipeline & Job Settings
PHOTO_GROUP_WINDOW_MS=45000
MAX_IMAGES_PER_JOB=12
MAX_EDIT_RETRIES=1
PER_IMAGE_TIMEOUT_MS=210000
PHOTO_TIME_BUDGET_MS=180000
COST_PER_1K_TOKENS_USD=0
